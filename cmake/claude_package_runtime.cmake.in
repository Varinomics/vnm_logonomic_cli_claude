cmake_minimum_required(VERSION 3.25)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM linux+elf)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")
set(index_arguments "${PACKAGE}"
    --third-party assets/claude.svg notices/lobe_icons_mit.txt provenance/lobe_icons.json)
set(notices "")
set(provenance "Resolved runtime libraries for the selected Linux toolchain\n")
foreach(relative adapter/claude_adapter helpers/claude_helper helpers/claude_launch_bridge)
    get_filename_component(directory "${relative}" DIRECTORY)
    # glibc and its loader belong to the supported OS. Keep compiler, TLS,
    # compression and other libraries in the delivered dependency closure.
    file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${PACKAGE}/${relative}"
        PRE_EXCLUDE_REGEXES "^ld-linux.*" "^linux-vdso.*" "^lib(c|m|dl|rt|pthread|resolv|util|anl)\\.so\\..*"
        RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
        CONFLICTING_DEPENDENCIES_PREFIX conflicts)
    if(unresolved OR conflicts_FILENAMES)
        message(FATAL_ERROR "Incomplete Claude runtime closure: ${unresolved}; ${conflicts_FILENAMES}")
    endif()
    foreach(runtime IN LISTS resolved)
        get_filename_component(name "${runtime}" NAME)
        file(REAL_PATH "${runtime}" original)
        set(destination "${directory}/${name}")
        if(destination IN_LIST copied)
            continue()
        endif()
        list(APPEND copied "${destination}")
        set(notice "@CLAUDE_RUNTIME_NOTICES_DIRECTORY@/${name}.txt")
        if(NOT EXISTS "${notice}")
            string(REGEX REPLACE "^/usr/" "/" merged_usr "${original}")
            foreach(candidate "${runtime}" "${original}" "${merged_usr}")
                execute_process(COMMAND dpkg-query -S "${candidate}"
                    RESULT_VARIABLE result OUTPUT_VARIABLE owner ERROR_QUIET)
                if(result EQUAL 0 AND owner MATCHES "^([^:\n]+)(:[^: \n]+)?: ")
                    set(notice "/usr/share/doc/${CMAKE_MATCH_1}/copyright")
                    if(EXISTS "${notice}")
                        break()
                    endif()
                endif()
            endforeach()
        endif()
        if(NOT EXISTS "${notice}")
            message(FATAL_ERROR "Missing notice for ${runtime}; set CLAUDE_RUNTIME_NOTICES_DIRECTORY with ${name}.txt")
        endif()
        if(NOT notice IN_LIST included_notices)
            file(READ "${notice}" license)
            string(APPEND notices "\n--- ${notice} ---\n${license}\n")
            list(APPEND included_notices "${notice}")
        endif()
        # The integrity index admits regular files, so dereference SONAME links.
        file(COPY_FILE "${original}" "${PACKAGE}/${destination}")
        file(SHA256 "${original}" digest)
        string(APPEND provenance "${destination} <- ${original} ${digest}\n")
        list(APPEND index_arguments --third-party "${destination}" notices/runtime.txt provenance/runtime.txt)
    endforeach()
endforeach()
file(WRITE "${PACKAGE}/notices/runtime.txt" "${notices}")
file(WRITE "${PACKAGE}/provenance/runtime.txt" "${provenance}")
execute_process(COMMAND "${INDEX}" ${index_arguments} COMMAND_ERROR_IS_FATAL ANY)
